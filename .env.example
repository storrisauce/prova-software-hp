# URL del progetto Supabase (Supabase -> Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chiave pubblica "anon" del progetto Supabase (stessa pagina, "anon public")
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chiave segreta "service_role" del progetto Supabase (stessa pagina, "service_role secret").
# NON deve mai iniziare con NEXT_PUBLIC_ e non deve mai arrivare al browser.
SUPABASE_SERVICE_ROLE_KEY=

# Token GitHub (Personal Access Token) con lettura sulle repository dei cervelli.
# Vede tutte le repo a cui ha accesso: sono i permessi nel database a decidere cosa
# arriva davvero all'utente (vedi src/app/api/chiedi/route.ts).
GITHUB_TOKEN=

# Chiave API Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
